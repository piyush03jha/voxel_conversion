{
  "name": "@formshift/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && npm run start:prod",
    "start:prod": "node --env-file-if-exists=../../.env dist/apps/api/src/main.js",
    "test": "npm run build && node --test dist/apps/api/src/*.test.js dist/apps/worker/src/*.test.js",
    "smoke:queue": "node --env-file-if-exists=../../.env scripts/smoke-queue.mjs",
    "start:worker": "node --env-file-if-exists=../../.env dist/apps/worker/src/main.js",
    "smoke:conversion": "node --env-file-if-exists=../../.env scripts/smoke-conversion.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "bullmq": "^5.56.0",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
