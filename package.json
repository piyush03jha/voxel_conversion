{
  "name": "voxel-conversion",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm ci --prefix apps/web && npm install --prefix apps/api",
    "dev": "npm run dev --prefix apps/web",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "npm run start --prefix apps/api",
    "build": "npm run build --prefix apps/web && npm run build --prefix apps/api",
    "lint": "npm run lint --prefix apps/web",
    "test": "npm run test --prefix apps/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "smoke:queue": "npm run smoke:queue --prefix apps/api"
  }
}
