PORT=3001
# HOST=0.0.0.0 # set for container/cloud deployment; local defaults to loopback
WEB_ORIGINS=http://localhost:5173

# Local Docker Compose Redis and SeaweedFS. Keep the existing local endpoint and credentials; replace them in production.
REDIS_URL=redis://127.0.0.1:6379
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=formshift-temp
STORAGE_ACCESS_KEY_ID=formshiftlocal
STORAGE_SECRET_ACCESS_KEY=formshift-local-dev-password
STORAGE_FORCE_PATH_STYLE=true

# Public conversion remains off pending integration tests and sandbox review.
# Set true for isolated local tests only. QUEUE_TEST_MODE permits queue-only tests without a worker.
QUEUE_ACCEPT_JOBS=false
PUBLIC_CONVERSION_APPROVED=false
QUEUE_TEST_MODE=false
QUEUE_CAPACITY=100
UPLOAD_URL_TTL_SECONDS=1800
MULTIPART_UPLOAD_TTL_SECONDS=7200
TEMP_INPUT_BUDGET_GIB=32
JOB_RETENTION_SECONDS=86400
DOWNLOAD_URL_TTL_SECONDS=300
UPLOADS_PER_MINUTE=30

# Set VITE_API_BASE_URL in apps/web/.env.local for a separately deployed frontend.

# Worker (one active conversion per process; scale replicas rather than concurrency).
WORKER_TIMEOUT_MS=1800000
# WORKER_PROCESS_MEMORY_MB=1536 # optional; otherwise derived from available RAM
WORKER_CONTAINER_MEMORY=3g
WORKER_MAX_ARCHIVE_MB=1024
WORKER_MAX_OUTPUT_MB=1024
WORKER_DISK_RESERVE_MB=512
# WORKER_MAX_TRIANGLES=4200000 # optional; otherwise derived from native process budget
WORKER_MAX_CELLS=1500000
WORKER_THREADS=1
WORKER_STL_ENGINE=native
# WORKER_TEMP_DIR=/tmp
# PYTHON_BIN=python3
# BLENDER_BIN=blender

# Existing ADVFX importers and glTF Transform. Public workers require bwrap.
# trusted-local is ONLY for isolated local testing of trusted files.
WORKER_SANDBOX=trusted-local
WORKER_BLENDER_ADDRESS_MB=4096
# WORKER_OPTIMIZER_HEAP_MB=1024 # optional; otherwise derived from available RAM
WORKER_OPTIMIZER_TIMEOUT_MS=1800000
# GLTF_TRANSFORM_BIN=gltf-transform
